# Copy to .env and fill in real values. See README.md for where each comes from.

# Spotify app credentials — https://developer.spotify.com/dashboard
# Both are read server-side only; nothing Spotify-related reaches the browser.
SPOTIFY_CLIENT_ID=your_client_id_here           # app id, read by /api/login
SPOTIFY_CLIENT_SECRET=your_client_secret_here   # never in client code

# Session-cookie encryption key — generate with: openssl rand -base64 32
# (must decode to exactly 32 bytes; the app throws a clear error otherwise)
COOKIE_ENCRYPTION_KEY=generate_with_openssl_rand_base64_32

# `vercel dev` runs the production shape on ONE origin: http://127.0.0.1:3000
# REDIRECT_URI must be registered in the Spotify dashboard.
REDIRECT_URI=http://127.0.0.1:3000/api/callback
FRONTEND_URL=http://127.0.0.1:3000

# Explore mode: minimum milliseconds between our calls to MusicBrainz/
# Nominatim (each), enforced globally via Redis. Both services' anonymous-use
# policies cap well-behaved clients at 1 req/sec — keep this comfortably
# above 1000.
GEOCODE_MIN_INTERVAL_MS=1100

# Explore mode: server-side geocode cache + rate limiter. Backed by Upstash
# Redis, provisioned via the Vercel Marketplace "Upstash for Redis"
# integration, which injects credentials under a REDIS_ prefix:
#   REDIS_KV_REST_API_URL
#   REDIS_KV_REST_API_TOKEN
# Auto-injected — do not set these by hand; pull them with `vercel env pull`.
# NOTE: `Redis.fromEnv()` does NOT work here. It only recognizes
# KV_REST_API_* or UPSTASH_REDIS_REST_* pairs, and this integration uses
# neither — it's REDIS_KV_REST_API_* instead. server/kv.js constructs the
# `Redis` client explicitly against these two vars for that reason; don't
# "simplify" it to `Redis.fromEnv()`, it will silently fail to authenticate.

# Not listed here (managed automatically, do not add by hand):
#   .env.local  — VERCEL_OIDC_TOKEN, pulled by `vercel dev` / `vercel link`
